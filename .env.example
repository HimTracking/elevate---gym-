# Use a long, unique secret ID for the admin login. Never share it with athletes.
ADMIN_ID=EPL-ADMIN-CHANGE-THIS-TO-A-LONG-UNIQUE-ID
SESSION_SECRET=replace-this-with-a-long-random-secret
PORT=3000
# Render persistent disk path (leave as-is for Render); local data defaults to ./data
DB_PATH=/var/data/elevate.db
